{
  "title": "Hospital LLM Benchmark",
  "uid": "hospital-llm-bench",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "instance",
        "label": "Instance",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(vllm:num_requests_running, instance)",
        "refresh": 2
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "TTFT p50 / p95 (ms)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(vllm:time_to_first_token_seconds_bucket[2m])) by (le)) * 1000",
          "legendFormat": "p50 TTFT"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(vllm:time_to_first_token_seconds_bucket[2m])) by (le)) * 1000",
          "legendFormat": "p95 TTFT"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ms", "color": { "mode": "palette-classic" } }
      }
    },
    {
      "id": 2,
      "title": "E2E Latency p50 / p95 / p99 (ms)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(vllm:e2e_request_latency_seconds_bucket[2m])) by (le)) * 1000",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(vllm:e2e_request_latency_seconds_bucket[2m])) by (le)) * 1000",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(vllm:e2e_request_latency_seconds_bucket[2m])) by (le)) * 1000",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ms" }
      }
    },
    {
      "id": 3,
      "title": "Throughput — Tokens/sec",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 8, "h": 7 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(vllm:generation_tokens_total[1m]))",
          "legendFormat": "tokens/sec"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short" }
      }
    },
    {
      "id": 4,
      "title": "Running / Waiting Requests",
      "type": "timeseries",
      "gridPos": { "x": 8, "y": 8, "w": 8, "h": 7 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "vllm:num_requests_running",
          "legendFormat": "running"
        },
        {
          "expr": "vllm:num_requests_waiting",
          "legendFormat": "waiting"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short" }
      }
    },
    {
      "id": 5,
      "title": "GPU Utilization %",
      "type": "timeseries",
      "gridPos": { "x": 16, "y": 8, "w": 8, "h": 7 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "DCGM_FI_DEV_GPU_UTIL",
          "legendFormat": "GPU {{gpu}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percent", "min": 0, "max": 100 }
      }
    },
    {
      "id": 6,
      "title": "GPU Memory Used / Free (MiB)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 15, "w": 8, "h": 7 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "DCGM_FI_DEV_FB_USED",
          "legendFormat": "Used {{gpu}}"
        },
        {
          "expr": "DCGM_FI_DEV_FB_FREE",
          "legendFormat": "Free {{gpu}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "decmbytes" }
      }
    },
    {
      "id": 7,
      "title": "HPA Replica Count",
      "type": "stat",
      "gridPos": { "x": 8, "y": 15, "w": 4, "h": 7 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "kube_horizontalpodautoscaler_status_current_replicas{horizontalpodautoscaler=\"inference-hpa\"}",
          "legendFormat": "replicas"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short",
          "thresholds": { "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 2 },
            { "color": "red", "value": 3 }
          ]}
        }
      }
    },
    {
      "id": 8,
      "title": "vLLM KV-Cache Utilization %",
      "type": "gauge",
      "gridPos": { "x": 12, "y": 15, "w": 4, "h": 7 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "vllm:gpu_cache_usage_perc * 100",
          "legendFormat": "KV cache"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percent", "min": 0, "max": 100,
          "thresholds": { "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 70 },
            { "color": "red", "value": 90 }
          ]}
        }
      }
    },
    {
      "id": 9,
      "title": "LLM Quality — JSON Validity / Function Calling / Instruction Following",
      "type": "bargauge",
      "gridPos": { "x": 0, "y": 22, "w": 12, "h": 7 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "hospital_benchmark_json_valid_rate",
          "legendFormat": "JSON Valid %"
        },
        {
          "expr": "hospital_benchmark_function_calling_success",
          "legendFormat": "Function Calling %"
        },
        {
          "expr": "hospital_benchmark_instruction_following_score",
          "legendFormat": "Instruction Following %"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "min": 0, "max": 1,
          "thresholds": { "steps": [
            { "color": "red", "value": null },
            { "color": "yellow", "value": 0.7 },
            { "color": "green", "value": 0.9 }
          ]}
        }
      }
    },
    {
      "id": 10,
      "title": "LLM Quality — Exact Match / F1 / ROUGE-L",
      "type": "bargauge",
      "gridPos": { "x": 12, "y": 22, "w": 12, "h": 7 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "hospital_benchmark_diagnosis_exact_rate",
          "legendFormat": "Diagnosis Exact"
        },
        {
          "expr": "hospital_benchmark_entity_f1",
          "legendFormat": "Entity F1"
        },
        {
          "expr": "hospital_benchmark_structured_json_score",
          "legendFormat": "Structured JSON"
        },
        {
          "expr": "hospital_benchmark_rouge_l",
          "legendFormat": "ROUGE-L"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "min": 0, "max": 1 }
      }
    },
    {
      "id": 11,
      "title": "Hallucination Rate",
      "type": "stat",
      "gridPos": { "x": 0, "y": 29, "w": 6, "h": 5 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "hospital_benchmark_hallucination_rate",
          "legendFormat": "Hallucination Rate"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "min": 0, "max": 1,
          "thresholds": { "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 0.05 },
            { "color": "red", "value": 0.15 }
          ]}
        }
      }
    },
    {
      "id": 12,
      "title": "Cost per 1M Tokens (USD) — g6e.xlarge @ $2.26/hr",
      "type": "stat",
      "gridPos": { "x": 6, "y": 29, "w": 6, "h": 5 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "(2.264 / 3600) / (sum(rate(vllm:generation_tokens_total[5m])) / 1000000)",
          "legendFormat": "$/1M tokens"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "currencyUSD", "decimals": 4 }
      }
    },
    {
      "id": 13,
      "title": "Risk Calibration — Brier Score (lower = better)",
      "type": "stat",
      "gridPos": { "x": 12, "y": 29, "w": 6, "h": 5 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "hospital_benchmark_risk_brier",
          "legendFormat": "Brier Score"
        }
      ],
      "fieldConfig": {
        "defaults": { "decimals": 4,
          "thresholds": { "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 0.10 },
            { "color": "red", "value": 0.20 }
          ]}
        }
      }
    }
  ]
}
